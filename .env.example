# Copy this file to .env and fill it in.

# PIN that reviewers type to sign in (share it only with the 1–2 reviewers).
REVIEWER_PIN=change-me

# PIN for the testing catalog (data/pantry.db). Leave empty to lock testing. Use a different PIN from REVIEWER_PIN.
TEST_PIN=

# How many hours a sign-in lasts before reviewers must sign in again. Default 8.
SESSION_HOURS=8

# Claude API key for "Add by photo". Without it, the photo screen returns demo results.
ANTHROPIC_API_KEY=
# Optional: which Claude model reads the photos.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Port the server listens on.
PORT=3000
